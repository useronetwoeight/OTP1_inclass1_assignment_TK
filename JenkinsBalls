pipeline {
    any agent
    tools {
        maven 'meiven'
    stages {
        stage('check') {
            steps {
                git 'https github .git'
            }
        }
        stage ('build') {
            steps {
                bat 'mvn clean install'
            }
        }
        stage ('test') {
            steps {
                bat 'mvn test'
            }
        }
        stage ('JaCOCO') {
            steps {
                jacoco()
            }
        }
    }
}